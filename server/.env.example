# Copy this file to .env before running the server.

# Port the Express API listens on.
PORT=4000

# Bearer token required (as the X-API-Key header) on write endpoints:
# POST /events, POST /events/replay?persist=true. Read endpoints are open.
# This is a demo key for local judging only — do not reuse it anywhere real.
API_KEY=demo-local-api-key-change-me

# Path to the SQLite database file, relative to the server/ directory.
# Created automatically on first run if it doesn't exist.
DATABASE_PATH=./data/engine.db

# Origin allowed to call write endpoints (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
